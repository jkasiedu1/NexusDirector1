+import { NextRequest, NextResponse } from "next/server";
+import { generateObject } from "ai";
+import { z } from "zod";
+import { createHash } from "crypto";
+import { deepSeekModel, deepSeekReasonerModel } from "@/lib/ai-providers";
+import {
+  EbookManifestSchema,
+  SectionDraftSchema,
+  ChapterDraftSchema,
+  FrontBackMatterSchema,
