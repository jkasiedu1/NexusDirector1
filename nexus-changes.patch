+  const ss = Math.floor((ms % 60000) / 1000);
+  const mmm = ms % 1000;
+  const pad = (value: number, size: number) => value.toString().padStart(size, "0");
+  return `${pad(hh, 2)}:${pad(mm, 2)}:${pad(ss, 2)},${pad(mmm, 3)}`;
+}
