+            onClick={() => {
+              setStage("idle");
+              setError(null);
+              setSignalFilterState("idle");
+              setSignalFilterDetail(null);
+              setChapters([]);
+              setLog([]);
+              logRef.current = [];
+              setExportUrls(null);
+              setCompletedManifest(null);
+              setTotalWords(0);
