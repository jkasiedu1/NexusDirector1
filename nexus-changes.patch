+            onUpdate={() => {}}
+            siteConfig={siteConfig}
+            onSiteUpdate={() => {}}
+            ebookManifest={ebookManifest}
+            onEbookUpdate={handleEbookUpdate}
+            ebookPipelineSnapshot={ebookPipelineSnapshot}
+          />
+        </main>
+      </div>
+    </div>
+  );
+}
