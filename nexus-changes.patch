+
+            {ui.accessibilityNotes.length > 0 && (
+              <div>
+                <p className="mb-2 text-[11px] font-semibold uppercase tracking-widest text-slate-500">Accessibility</p>
+                <ul className="space-y-1">
+                  {ui.accessibilityNotes.map((note, i) => (
