+
+        {/* ── UI Spec ── */}
+        {activeTab === "ui" && ui !== null && (
+          <div className="space-y-4">
+            <div>
+              <p className="mb-1 text-[11px] font-semibold uppercase tracking-widest text-slate-500">Visual Direction</p>
+              <p className="text-slate-300">{ui.visualDirection}</p>
