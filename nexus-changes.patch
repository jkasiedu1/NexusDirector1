+      <>
+
+      {/* ── CSS keyframes for equalizer bars ── */}
+      <style>{`
+        @keyframes nxEqA { 0%,100%{height:3px} 50%{height:11px} }
+        @keyframes nxEqB { 0%,100%{height:8px} 40%{height:3px} 80%{height:13px} }
+        @keyframes nxEqC { 0%,100%{height:5px} 60%{height:12px} }
