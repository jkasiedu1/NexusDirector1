+        </div>
+
+        {/* Speed pill */}
+        <button onClick={cycleRate} aria-label="Change speed" style={{
+          fontSize: "0.68rem", fontFamily, fontWeight: 700,
+          color: theme.accent,
+          background: `${theme.accent}14`,
+          border: `1px solid ${theme.accent}3a`,
