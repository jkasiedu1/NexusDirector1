+  success: { tag: "DONE", tagCls: "border-emerald-400/30 bg-emerald-400/10 text-emerald-400", msgCls: "text-slate-100" },
+  warn:    { tag: "WARN", tagCls: "border-amber-400/30   bg-amber-400/10   text-amber-400",   msgCls: "text-amber-100" },
